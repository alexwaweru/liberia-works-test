{
  "name": "liberia-works",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "pre-commit": [
    "build",
    "lint",
    "typecheck",
    "test"
  ],
  "devDependencies": {
