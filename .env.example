# Copy to .env and fill in values.
# In production, all secrets are managed by Doppler — never commit real values.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5434/liberiaworks

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (min 32 chars) ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Africa's Talking ──────────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# ── DigitalOcean Spaces ───────────────────────────────────────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_BUCKET=liberiaworks-documents
DO_SPACES_REGION=fra1

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Web app (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
