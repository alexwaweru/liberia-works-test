# Copy to .env and fill in values.
# In production, all secrets are managed through Vercel project env vars.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database (Supabase Postgres in production) ───────────────────────────────
# DATABASE_URL is the pooled connection (pgBouncer transaction mode, port 6543);
# Vercel functions reuse it across invocations. Append
# `?pgbouncer=true&connection_limit=1` for Supabase pooler.
# DIRECT_URL is the unpooled connection (port 5432); used only by `prisma migrate`.
DATABASE_URL=postgresql://postgres:password@localhost:5434/liberiaworks
DIRECT_URL=postgresql://postgres:password@localhost:5434/liberiaworks

# ── Redis (Upstash in production) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (min 32 chars) ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Africa's Talking ──────────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# ── Vercel Blob (file uploads) ───────────────────────────────────────────────
# Generated via `vercel blob create` or the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# ── Inngest (background jobs) ────────────────────────────────────────────────
# Local: leave blank — the Inngest dev server (`npx inngest-cli@latest dev`)
# auto-discovers your /api/inngest endpoint.
# Production: copy from the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Web app (Next.js) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
