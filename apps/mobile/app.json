{
  "expo": {
    "name": "Liberia Works",
    "slug": "liberia-works",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2342"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.liberiaworks.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2342"
      },
      "package": "com.liberiaworks.app"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "liberiaworks",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}
