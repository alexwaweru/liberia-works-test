{
  "name": "@liberia-works/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:generate": "prisma generate",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:locations": "dotenv -e ../../.env -- tsx prisma/seed-locations.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.0.0",
    "@liberia-works/shared-schemas": "workspace:*",
    "@liberia-works/shared-types": "workspace:*",
    "@liberia-works/shared-utils": "workspace:*",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@scalar/fastify-api-reference": "^1.52.4",
    "bullmq": "^5.0.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.3.2",
    "pg": "^8.20.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.2",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
